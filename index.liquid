---
layout: base
title: Sarcastic Existentialist
---
<p><i>{{ site.tagline }}</i></p>

<ul class="blog-posts">
  {%- for post in collections.posts reversed %}
  <li>
    <span><i><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></i></span>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
  </li>
  {%- endfor %}
</ul>
