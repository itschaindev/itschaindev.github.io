---
layout: base
---
{%- assign ownTags = tags | postTags -%}
<article>
  <h1>{{ title }}</h1>
  {% if subtitle %}<p><i>{{ subtitle }}</i></p>{% endif %}
  <p class="meta"><i>
    <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
    &middot; {{ content | readingTime: site.wordsPerMinute }} min read
    {%- if ownTags.size > 0 %} &middot; {% for tag in ownTags %}<a href="/tags/#{{ tag | slugify }}">{{ tag }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}{% endif %}
  </i></p>

  {{ content }}
</article>

{%- assign older = collections.posts | getPreviousCollectionItem -%}
{%- assign newer = collections.posts | getNextCollectionItem -%}
{% if older or newer %}
<hr>
<nav class="post-nav" aria-label="Neighbouring posts">
  <span>{% if older %}&larr; <a href="{{ older.url }}" rel="prev">{{ older.data.title }}</a>{% endif %}</span>
  <span>{% if newer %}<a href="{{ newer.url }}" rel="next">{{ newer.data.title }}</a> &rarr;{% endif %}</span>
</nav>
{% endif %}
