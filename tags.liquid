---
layout: page
title: Tags
---
{%- if collections.tagList.size == 0 %}
<p>Nothing has been tagged yet.</p>
{%- else %}
<p>
  {%- for tag in collections.tagList %}
  <a href="#{{ tag.name | slugify }}">{{ tag.name }}</a> ({{ tag.items.size }}){% unless forloop.last %} &middot;{% endunless %}
  {%- endfor %}
</p>
{%- for tag in collections.tagList %}

<h2 id="{{ tag.name | slugify }}">{{ tag.name }}</h2>
<ul class="blog-posts">
  {%- for post in tag.items %}
  <li>
    <span><i><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></i></span>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
  </li>
  {%- endfor %}
</ul>
{%- endfor %}
{%- endif %}
